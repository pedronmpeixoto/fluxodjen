# Variáveis de ambiente lidas pelos nós de código do workflow.
# Configure na instância do n8n (não versione o arquivo .env real).
# Os nós Code precisam de acesso a $env: N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Host da API de publicações (sem https://)
DJEN_API_HOST=api.exemplo.com.br

# Um par por termo de pesquisa cadastrado (até 10)
DJEN_LOGIN_1=
DJEN_SENHA_1=
DJEN_LOGIN_2=
DJEN_SENHA_2=
